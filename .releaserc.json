{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i '0,/^version = /s/^version = \"[^\"]*\"/version = \"${nextRelease.version}\"/' Cargo.toml && sed -i '/^name = \"dev-events-bridge-core\"$/{n;s/^version = \"[^\"]*\"/version = \"${nextRelease.version}\"/}' Cargo.lock"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "Cargo.toml",
          "Cargo.lock"
        ],
        "message": "chore(release): v${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failTitle": false
      }
    ]
  ]
}
